{
  "name": "@ubercode/compliant-constructs",
  "version": "0.1.0",
  "description": "Compliance-hardened AWS CDK constructs that make the compliant configuration the default and the non-compliant one unrepresentable, plus generated control-coverage evidence.",
  "keywords": [
    "aws",
    "cdk",
    "aws-cdk",
    "constructs",
    "compliance",
    "cmmc",
    "cmmc2",
    "nist",
    "nist-800-171",
    "cdk-nag",
    "govcloud",
    "cui",
    "typescript"
  ],
  "author": "Michael Lee Hobbs <michael.lee.hobbs@gmail.com> (https://github.com/MichaelLeeHobbs)",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.4",
  "peerDependencies": {
    "aws-cdk-lib": "^2.257.0",
    "cdk-nag": "^3.0.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "aws-cdk-lib": "^2.262.2",
    "cdk-nag": "^3.0.1",
    "constructs": "^10.8.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jiti": "^2.5.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.mjs",
      "require": "./dist/verify.js"
    },
    "./cmmc2": {
      "types": "./dist/cmmc2/index.d.ts",
      "import": "./dist/cmmc2/index.mjs",
      "require": "./dist/cmmc2/index.js"
    },
    "./cmmc2/aws-efs": {
      "types": "./dist/cmmc2/aws-efs/index.d.ts",
      "import": "./dist/cmmc2/aws-efs/index.mjs",
      "require": "./dist/cmmc2/aws-efs/index.js"
    },
    "./cmmc2/patterns": {
      "types": "./dist/cmmc2/patterns/index.d.ts",
      "import": "./dist/cmmc2/patterns/index.mjs",
      "require": "./dist/cmmc2/patterns/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cmmc2/",
    "data/MANIFEST.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist coverage cmmc2 verify",
    "build": "tsup && node scripts/gen-subpath-stubs.mjs",
    "build:watch": "tsup --watch",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "preversion": "pnpm run test && pnpm run build",
    "postversion": "git push && git push --tags",
    "version:major": "npm version major",
    "version:minor": "npm version minor",
    "version:patch": "npm version patch",
    "dry-run": "npm pack --dry-run",
    "test": "pnpm run test:format && pnpm run test:lint && pnpm run catalog:check && pnpm run test:types && pnpm run test:unit",
    "test:format": "prettier --check \"{src,tests,scripts}/**/*.{ts,mjs,js,json,md}\" \"*.{mts,ts,json,md}\" \".github/**/*.yml\"",
    "test:lint": "eslint",
    "test:types": "tsc --noEmit",
    "test:unit": "node node_modules/jest/bin/jest.js",
    "test:cover": "node node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node node_modules/jest/bin/jest.js --watch",
    "test:ci": "pnpm run test:format && pnpm run test:lint && pnpm run catalog:check && pnpm run test:types && pnpm run test:cover",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,mjs,js,json,md}\" \"*.{mts,ts,json,md}\" \".github/**/*.yml\"",
    "lint": "eslint --fix",
    "precommit": "lint-staged",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelLeeHobbs/compliant-constructs.git"
  },
  "homepage": "https://github.com/MichaelLeeHobbs/compliant-constructs#readme",
  "bugs": {
    "url": "https://github.com/MichaelLeeHobbs/compliant-constructs/issues"
  },
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{ts,js,mjs,json,md}": "prettier --write",
    "*.{ts,js,mjs}": "eslint --fix"
  },
  "peerDependenciesMeta": {
    "cdk-nag": {
      "optional": true
    }
  }
}
